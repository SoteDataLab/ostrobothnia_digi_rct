* Import raw data from Qualtrics/Excel
import excel "~DIGIn\All_raw_data.xlsx", sheet("Sheet0") firstrow

***** Data preparation (cleaning, reshaping....)

*Convert timestamp column into variables expressing date and time 

* 1. Extract Start_date only (%td)
gen Start_date = dofc(StartDate)
format Start_date %td

* 2. Extract Start_time in decimal hours
gen tsec = mod(StartDate, 86400000)       // milliseconds since midnight
gen Start_hour = floor(tsec / 3600000)
gen Start_minute = floor((tsec - Start_hour*3600000) / 60000)

drop tsec

* 3. Create Start_Time_string, HH:MM
gen str5 Start_time_str = string(Start_hour,"%02.0f") + ":" + string(Start_minute,"%02.0f")

* 4. Extract End_date only (%td)
gen End_date = dofc(EndDate)
format End_date %td

* 5. Extract End_time in decimal hours
gen tsec = mod(EndDate, 86400000)       // milliseconds since midnight
gen End_hour = floor(tsec / 3600000)
gen End_minute = floor((tsec - End_hour*3600000) / 60000)

drop tsec

* 6. Create End_Time_string, HH:MM
gen str5 End_time_str = string(End_hour,"%02.0f") + ":" + string(End_minute,"%02.0f")


order StartDate Start_date Start_hour Start_minute Start_time_str EndDate End_date End_hour End_minute End_time_str

*************************************************************************************************************************

